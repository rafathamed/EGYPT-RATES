{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EGYPT RATES",
  "version": "0.2.0",
  "identifier": "com.rafathamed.egypt-rates",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EGYPT RATES",
        "width": 420,
        "height": 780,
        "minWidth": 390,
        "minHeight": 720,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "maxWidth": 460,
        "maxHeight": 860,
        "skipTaskbar": true,
        "minimizable": false,
        "maximizable": false,
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
